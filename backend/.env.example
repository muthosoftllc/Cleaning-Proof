# Copy to .env and fill in. Never commit the real file.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=cleaningproof.app,api.cleaningproof.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://cleaningproof.app
PUBLIC_BASE_URL=https://cleaningproof.app
DATABASE_URL=postgres://cleaningproof:cleaningproof@db:5432/cleaningproof

# Evidence storage. Default: local disk volume (MEDIA_ROOT). For S3-compatible
# object storage, install django-storages[s3] and set
# DEFAULT_FILE_STORAGE=storages.backends.s3.S3Storage plus AWS_* settings with a
# PRIVATE bucket; files are always served via signed, expiring URLs.
MEDIA_ROOT=/app/media
SIGNED_URL_MAX_AGE_SECONDS=900

# Push notifications (Firebase Cloud Messaging HTTP v1)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Google Play Billing
GOOGLE_PLAY_PACKAGE_NAME=app.cleaningproof
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_RTDN_TOKEN=
BILLING_FAKE_VERIFIER=0
